# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the seed script and authenticated cleanup cron. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret (at least 16 characters). Vercel sends it to the daily cleanup cron.
CRON_SECRET=

# Demo account created by `npm run seed` (share these with reviewers, not in git).
DEMO_EMAIL=
DEMO_PASSWORD=

# Optional browser tests. Use a disposable account with the schema applied.
# Leave E2E_BASE_URL blank to test the local app; set it to test a deployment.
E2E_BASE_URL=
E2E_EMAIL=
E2E_PASSWORD=
